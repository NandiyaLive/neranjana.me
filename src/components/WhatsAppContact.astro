---
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---

<div class="flex items-start gap-4" data-whatsapp data-sitekey={siteKey}>
  <div class="rounded-lg bg-yellow-500/10 p-3 text-yellow-500">
    <svg
      viewBox="0 0 24 24"
      fill="currentColor"
      class="h-6 w-6"
      aria-hidden="true"
    >
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z" />
    </svg>
  </div>
  <div>
    <h3 class="font-semibold">WhatsApp</h3>
    <div data-turnstile></div>
    <button
      type="button"
      data-whatsapp-button
      class="opacity-80 transition-colors hover:text-yellow-500 hover:opacity-100 disabled:cursor-wait disabled:opacity-40"
    >
      Open WhatsApp chat
    </button>
    <p
      class="mt-1 text-sm text-red-600 dark:text-red-500"
      data-whatsapp-error
      hidden
    >
      Verification failed. Reload the page and try again.
    </p>
  </div>
</div>

<script
  is:inline
  src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit"
  async
  defer
></script>
<script is:inline>
  const root = document.querySelector("[data-whatsapp]");
  const button = root.querySelector("[data-whatsapp-button]");
  const error = root.querySelector("[data-whatsapp-error]");
  const container = root.querySelector("[data-turnstile]");
  let widgetId;

  const getToken = () =>
    new Promise((resolve, reject) => {
      const options = {
        sitekey: root.dataset.sitekey,
        appearance: "interaction-only",
        callback: resolve,
        "error-callback": reject,
      };
      if (widgetId !== undefined) turnstile.remove(widgetId);
      widgetId = turnstile.render(container, options);
    });

  button.addEventListener("click", async () => {
    button.disabled = true;
    error.hidden = true;
    // Open the tab synchronously so popup blockers see the click, then point it at the link.
    const tab = window.open("", "_blank");
    if (tab) tab.opener = null;
    try {
      const token = await getToken();
      const res = await fetch("/api/whatsapp", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ token }),
      });
      if (!res.ok) throw new Error();
      const { url } = await res.json();
      if (tab) tab.location.href = url;
      else window.location.href = url;
    } catch {
      tab?.close();
      error.hidden = false;
    } finally {
      button.disabled = false;
    }
  });
</script>
