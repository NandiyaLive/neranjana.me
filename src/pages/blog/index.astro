---
import Layout from '@/layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { Card, CardContent, CardHeader, CardTitle } from '@/ui/card';
import { Badge } from '@/ui/badge';
const posts = (await getCollection('blog')).sort((a,b) => b.data.date.getTime() - a.data.date.getTime());
const description = 'Thoughts, tutorials, and insights on web development and technology.';
---
<Layout title="Blog" description={description}>
  <main id="main-content" class="page-main container pt-24 pb-16">
    <section class="mb-12"><h1 class="mb-4 text-4xl font-bold tracking-tight sm:text-5xl">Blog</h1><p class="text-lg text-muted-foreground">{description}</p></section>
    {posts.length === 0 ? <div class="py-12 text-center text-muted-foreground"><p class="text-lg">No blog posts yet. Stay tuned!</p></div> : <section class="grid gap-6">{posts.map(post => <a href={`/blog/${post.id}`}><Card class="gap-2 hover:shadow-lg"><CardHeader><CardTitle><h2 class="text-2xl">{post.data.title}</h2></CardTitle><p class="text-sm text-muted-foreground"><time datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString('en-US', {year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC'})}</time>{post.data.author && ` · By ${post.data.author}`}</p></CardHeader><CardContent class="space-y-4"><p class="text-muted-foreground">{post.data.description}</p><div class="flex flex-wrap gap-2">{post.data.tags.map(tag => <Badge variant="secondary">{tag}</Badge>)}</div></CardContent></Card></a>)}</section>}
  </main>
</Layout>
