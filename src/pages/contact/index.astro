---
import Layout from '@/layouts/Layout.astro';
import { Clock, CircleQuestionMark, Mail } from '@lucide/astro';
import { FAQS } from '@/data/faq';
import { socialLinks } from '@/data/social-links';
import SocialIcon from '@/components/SocialIcon.astro';
---
<Layout title="Contact" description="Get in touch with me for freelance work or any inquiries you may have.">
<main id="main-content" class="page-main container mx-auto max-w-7xl pt-24 pb-16">
    <div class="grid grid-cols-1 gap-12 md:grid-cols-2">
      <section>
        <h1 class="mb-6 text-4xl font-bold">Let's Work Together</h1>
        <p class="mb-8 text-lg leading-relaxed opacity-90">
          I'm currently available for freelance work. If you're
          interested in working with me, feel free to reach out via email or
          through any of my social channels.
        </p>

        <div class="space-y-6">
          <div class="flex items-start gap-4">
            <div class="rounded-lg bg-yellow-500/10 p-3 text-yellow-500">
              <Mail class="h-6 w-6" />
            </div>
            <div>
              <h3 class="font-semibold">Email</h3>
              <a
                href="mailto:hello@neranjana.me"
                class="opacity-80 transition-colors hover:text-yellow-500 hover:opacity-100"
              >
                hello@neranjana.me
              </a>
            </div>
          </div>

          {socialLinks.map((social) => {
            
            return (
              <div class="flex items-center gap-4">
                <div class="rounded-lg bg-yellow-500/10 p-3 text-yellow-500">
                  <SocialIcon platform={social.platform} class="h-6 w-6" />
                </div>
                <div>
                  <h3 class="font-semibold">{social.platform}</h3>
                  <a
                    href={social.link}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="opacity-80 transition-colors hover:text-yellow-500 hover:opacity-100"
                  >
                    @{social.handle}
                  </a>
                </div>
              </div>
            );
          })}
        </div>

        <div class="mt-12 rounded-xl border border-neutral-200 p-6 dark:border-neutral-800">
          <h3 class="mb-2 flex items-center gap-2 font-semibold">
            <Clock class="h-5 w-5" />
            Availability
          </h3>
          <p class="opacity-80">I'm currently <span class="font-semibold text-green-600 dark:text-green-500">available</span> for new projects. Expected response time: 24-48 hours.</p>
        </div>
      </section>

      <section>
        <h2 class="mb-6 text-3xl font-bold">Frequently Asked Questions</h2>

        <div class="space-y-6">
          {FAQS.map((faq) => (
            <div
              class="rounded-xl border border-neutral-200 p-6 select-none dark:border-neutral-800"
            >
              <h3 class="mb-2 flex items-start gap-2 font-semibold">
                <CircleQuestionMark class="mt-0.5 h-5 w-5 text-yellow-500" />
                {faq.question}
              </h3>
              <p class="ml-7 leading-relaxed opacity-80">{faq.answer}</p>
            </div>
          ))}
        </div>
      </section>
    </div>
  </main>
</Layout>
