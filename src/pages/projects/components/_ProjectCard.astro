---
import { Card, CardContent, CardHeader, CardTitle } from '@/ui/card';
import { Badge } from '@/ui/badge';
import { Construction, Link as LinkIcon } from '@lucide/astro';
interface Props { name: string; description?: string; url: string; completed: boolean; active?: boolean }
const {name, description, url, completed, active = true} = Astro.props;
---
<Card class="border-border bg-card/40 gap-2 shadow-none backdrop-blur-sm">
  <CardHeader><CardTitle><h3 class="text-xl">{name}</h3></CardTitle></CardHeader>
  <CardContent class="flex h-full flex-col justify-between gap-4">
    {description ? <p class="text-muted-foreground">{description}</p> : <slot />}
    <div class="flex flex-wrap items-center justify-between gap-2 text-sm font-medium">
      {completed ? <a href={`https://${url}`} target="_blank" rel="noopener noreferrer" class:list={['inline-flex items-center gap-2 hover:text-yellow-500 break-all', !active && 'line-through']}><LinkIcon class="size-3 shrink-0" />{url}</a> : <p class="flex items-center gap-2"><Construction class="size-3" />In Progress</p>}
      {!active && <Badge variant="destructive">Inactive</Badge>}
    </div>
  </CardContent>
</Card>
